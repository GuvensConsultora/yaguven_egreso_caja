<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        La acción queda vinculada al modelo (`binding_model_id`), así el comprobante
        aparece solo en el menú «Imprimir» del formulario y de la lista, sin que haya
        que agregar un botón a mano.

        Se puede imprimir en cualquier estado a propósito: el papel se firma al
        entregar la plata y el egreso se confirma después. El propio PDF avisa
        «SIN CONFIRMAR» mientras no tenga asiento.
    -->

    <!--
        El A4 por defecto reserva 52 mm arriba para el encabezado de página, y acá
        el encabezado va dentro del cuerpo (hay dos por hoja): con ese margen las
        dos copias no entran. Este formato deja márgenes de trabajo y nada de
        espacio reservado.
    -->
    <record id="paperformat_egreso_caja" model="report.paperformat">
        <field name="name">Comprobante de egreso de caja</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">6.0</field>
        <field name="margin_bottom">6.0</field>
        <field name="margin_left">8.0</field>
        <field name="margin_right">8.0</field>
        <field name="header_spacing">0</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_egreso_caja" model="ir.actions.report">
        <field name="name">Comprobante para firmar</field>
        <field name="model">yaguven.egreso.caja</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">yaguven_egreso_caja.report_egreso_caja_documento</field>
        <field name="report_file">yaguven_egreso_caja.report_egreso_caja_documento</field>
        <field name="print_report_name">
            'Egreso de caja %s' % ((object.name or '').replace('/', '-'))
        </field>
        <field name="binding_model_id" ref="model_yaguven_egreso_caja"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_egreso_caja"/>
    </record>

</odoo>
